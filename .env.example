# Copy to .env.local and fill in. The server refuses to start without the
# server-side keys below.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://app.arcjet.com — site key, `arcjet sites get-key --site-id <id>`
ARCJET_KEY=

# Optional, local only. Feature 10 added rules keyed by the caller's IP, and
# localhost has none — without this the fingerprint cannot be built, the whole
# decision errors, and every rule fails open. Set it to `development` to check
# bot detection or a rate limit by hand. Never set in production.
# ARCJET_ENV=development

# Postgres connection string, e.g. from Prisma Postgres
DATABASE_URL=

# https://dashboard.clerk.com — required, the server refuses to start without them
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# https://posthog.com — project settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
