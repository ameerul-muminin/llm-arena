# Copy to .env.local and fill in. The server refuses to start without the
# server-side keys below.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://app.arcjet.com — site key, `arcjet sites get-key --site-id <id>`
ARCJET_KEY=

# Postgres connection string, e.g. from Prisma Postgres
DATABASE_URL=

# https://dashboard.clerk.com — required, the server refuses to start without them
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# https://posthog.com — project settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
